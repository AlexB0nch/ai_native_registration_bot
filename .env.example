# Скопируйте в .env для локального запуска (docker compose up).
# В Coolify те же переменные задаются в Environment Variables ресурса.
# Секреты генерируются командой: openssl rand -hex 32

# Telegram: токен от @BotFather (обязательно)
BOT_TOKEN=
# Секрет вебхука: Telegram присылает его в X-Telegram-Bot-Api-Secret-Token (обязательно)
TELEGRAM_WEBHOOK_SECRET=
# Публичный адрес сервиса; вебхук = PUBLIC_BASE_URL + /tg/webhook
PUBLIC_BASE_URL=https://reg.alexshein.com

# База данных (обязательно). Пароль внутри DATABASE_URL = POSTGRES_PASSWORD
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://bot:<POSTGRES_PASSWORD>@db:5432/ai_native_bot

# chat_id владельца и помощников через запятую (узнать: команда /whoami в боте)
ADMIN_CHAT_IDS=
# Политика обработки персональных данных
PRIVACY_URL=https://alexshein.com/privacy
# Секрет для POST /api/site-registrations (= BOT_WEBHOOK_SECRET сервиса форм сайта)
SITE_WEBHOOK_SECRET=

# Модель для ответов на вопросы: deepseek | anthropic | stub
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# При старте: setWebhook, описание и команды бота
SETUP_BOT_ON_START=true
LOG_LEVEL=INFO
